# RAG 系统环境变量配置

# ==================== Milvus 配置 ====================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION=unified_docs

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SESSION_TTL=1800  # 会话过期时间（秒），默认30分钟

# ==================== LLM 配置 ====================
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# 备选：本地 LLM（如果使用 Ollama 或其他本地模型）
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:72b

# ==================== Embedding 配置 ====================
# BGE-M3 本地部署
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu  # cpu 或 cuda
EMBEDDING_BATCH_SIZE=32

# 备选：OpenAI Embedding
USE_OPENAI_EMBEDDING=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ==================== API 服务配置 ====================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true  # 开发环境设为 true，生产环境设为 false

# CORS 配置
CORS_ORIGINS=http://localhost:3000,http://localhost:5173  # 前端地址

# ==================== 日志配置 ====================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json  # json 或 text
LOG_FILE=logs/rag_system.log

# ==================== 检索配置 ====================
# 向量检索参数
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.7
RETRIEVAL_METRIC_TYPE=IP  # IP (内积) 或 L2 (欧氏距离)

# Rerank 配置（可选）
ENABLE_RERANK=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=3

# ==================== 缓存配置 ====================
ENABLE_QUERY_CACHE=true
CACHE_TTL=3600  # 缓存过期时间（秒），默认1小时

# ==================== 监控配置 ====================
# LangSmith（可选）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=rag-system

# Prometheus（可选）
ENABLE_METRICS=false
METRICS_PORT=9090

# ==================== 数据摄入配置 ====================
# 文本分块参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 支持的文件格式
SUPPORTED_FORMATS=md,pdf,docx,txt

# ==================== 业务系统 API 配置 ====================
# 仿真系统 API
SIMULATION_API_BASE_URL=http://simulation-api.example.com
SIMULATION_API_KEY=your_simulation_api_key_here
SIMULATION_API_TIMEOUT=30

# 毛利数据库
PROFIT_DB_HOST=localhost
PROFIT_DB_PORT=5432
PROFIT_DB_NAME=profit_db
PROFIT_DB_USER=profit_user
PROFIT_DB_PASSWORD=your_db_password_here

# ==================== 安全配置 ====================
# API 认证（可选）
ENABLE_AUTH=false
API_KEY=your_api_key_here
JWT_SECRET=your_jwt_secret_here

# ==================== 开发配置 ====================
# 开发模式
DEBUG=true
ENVIRONMENT=development  # development, staging, production

# 测试数据
USE_MOCK_DATA=false
