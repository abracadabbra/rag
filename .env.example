# RAG 系统环境变量配置

# ==================== Milvus 配置 ====================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION=unified_docs

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SESSION_TTL=1800  # 会话过期时间（秒），默认30分钟

# ==================== LLM 配置 ====================
# 当前使用的 LLM Provider: minimax / openai / local
LLM_PROVIDER=minimax

# MiniMax (通过 topapi 代理)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_API_BASE=https://topapi.link/v1
MINIMAX_MODEL=MiniMax-M2.7-highspeed

# OpenAI (备选)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2000

# 本地 LLM（如果使用 Ollama 或其他本地模型）
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:72b

# ==================== Embedding 配置 ====================
# BGE-M3 本地部署
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu  # cpu 或 cuda
EMBEDDING_BATCH_SIZE=32

# 备选：OpenAI Embedding
USE_OPENAI_EMBEDDING=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 离线开发/CI smoke 可用；生产语义检索不要开启
USE_DETERMINISTIC_EMBEDDING=false
DETERMINISTIC_EMBEDDING_DIMENSION=384

# ==================== API 服务配置 ====================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true  # 开发环境设为 true，生产环境设为 false

# CORS 配置
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]  # 前端地址

# ==================== 日志配置 ====================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=json  # json 或 text
LOG_FILE=logs/rag_system.log

# ==================== 检索配置 ====================
# 向量检索参数
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.7
RETRIEVAL_METRIC_TYPE=IP  # IP (内积) 或 L2 (欧氏距离)

# Rerank 配置（可选）
ENABLE_RERANK=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_K=3

# ==================== 缓存配置 ====================
ENABLE_QUERY_CACHE=true
CACHE_TTL=3600  # 缓存过期时间（秒），默认1小时

# ==================== 监控配置 ====================
# LangSmith（可选）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=rag-system

# Prometheus（可选）
ENABLE_METRICS=false
METRICS_PORT=9090

# ==================== 数据摄入配置 ====================
# 文本分块参数
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 支持的文件格式
SUPPORTED_FORMATS=["md","pdf","docx","txt"]

# ==================== 业务系统 API 配置 ====================
# 业务工具开关（风控/毛利订单级接口）
ENABLE_BUSINESS_TOOLS=true
BUSINESS_TOOL_TIMEOUT=5
BUSINESS_TOOL_CORPUS_CHECK_TIMEOUT=1.0

# 模糊问题的 LLM 工具意图兜底（默认关闭，规则优先）
ENABLE_BUSINESS_TOOL_LLM_INTENT=false
BUSINESS_TOOL_LLM_INTENT_MIN_CONFIDENCE=0.75

# 安全审计 JSONL 落盘（默认关闭，启用后仅写脱敏摘要）
ENABLE_BUSINESS_TOOL_AUDIT_FILE=false
BUSINESS_TOOL_AUDIT_FILE=logs/business_tool_audit.jsonl

# 订单级业务工具访问控制（默认关闭；启用后请求需带 X-Business-Tool-Token）
ENABLE_BUSINESS_TOOL_ACCESS_CONTROL=false
# 全权限兼容 token；可读可执行
BUSINESS_TOOL_ACCESS_TOKEN=
# 只读 token：允许审计读取和响应样例校验
BUSINESS_TOOL_READ_TOKEN=
# 执行 token：允许订单查询、SSE 和接口探测；也允许只读入口
BUSINESS_TOOL_EXECUTE_TOKEN=

# 风控 HTTP 接口；留空时使用 Mock 数据
RISK_API_BASE_URL=
RISK_API_KEY=

# 毛利 HTTP 接口；留空时使用 Mock 数据
PROFIT_API_BASE_URL=
PROFIT_API_KEY=

# 仿真系统 API
SIMULATION_API_BASE_URL=http://simulation-api.example.com
SIMULATION_API_KEY=your_simulation_api_key_here
SIMULATION_API_TIMEOUT=30

# 毛利数据库
PROFIT_DB_HOST=localhost
PROFIT_DB_PORT=5432
PROFIT_DB_NAME=profit_db
PROFIT_DB_USER=profit_user
PROFIT_DB_PASSWORD=your_db_password_here

# ==================== 安全配置 ====================
# API 认证（可选）
ENABLE_AUTH=false
API_KEY=your_api_key_here
JWT_SECRET=your_jwt_secret_here

# ==================== 开发配置 ====================
# 开发模式
DEBUG=true
ENVIRONMENT=development  # development, staging, production

# 测试数据
USE_MOCK_DATA=false
